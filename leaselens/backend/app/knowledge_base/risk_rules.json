{
  "_note": "Deterministic keyword rules. Each pattern is a case-insensitive Python regular expression matched against one clause. A rule only says a clause deserves attention; it never decides that a clause is illegal or unenforceable.",
  "rules": [
    {"id": "AR-01", "category": "auto_renewal", "level": "medium",
     "pattern": "\\b(automatically|auto[- ]?)\\s*renew",
     "description": "The agreement renews automatically unless someone cancels."},
    {"id": "AR-02", "category": "auto_renewal", "level": "medium",
     "pattern": "renew\\w*.{0,80}\\b(unless|until)\\b.{0,60}\\bnotice\\b",
     "description": "Renewal continues unless written notice is given in time."},
    {"id": "AR-03", "category": "auto_renewal", "level": "high",
     "pattern": "\\b(60|90|120|sixty|ninety)\\s*(\\(\\d+\\)\\s*)?days?\\b.{0,80}\\b(before|prior to)\\b.{0,40}\\b(expir|end|renew)",
     "description": "A long notice window is needed to stop the renewal."},

    {"id": "SD-01", "category": "security_deposit", "level": "medium",
     "pattern": "\\bnon[- ]?refundable\\b",
     "description": "Part of a payment is described as non-refundable."},
    {"id": "SD-02", "category": "security_deposit", "level": "medium",
     "pattern": "deposit.{0,120}\\b(deduct|withh[oe]ld|forfeit|retain)",
     "description": "The deposit can be deducted, withheld or kept."},
    {"id": "SD-03", "category": "security_deposit", "level": "high",
     "pattern": "deposit.{0,160}\\b(sole discretion|any reason|for any purpose)",
     "description": "The other side alone decides what is deducted from the deposit."},

    {"id": "FE-01", "category": "fees", "level": "medium",
     "pattern": "\\b(administrative|admin|processing|service|convenience|amenity|cleaning|documentation)\\s+(fee|charge)s?\\b",
     "description": "An extra fee is charged on top of the main payment."},
    {"id": "FE-02", "category": "fees", "level": "medium",
     "pattern": "\\b(additional|other|further)\\s+(fees?|charges?|costs?)\\b.{0,60}\\b(may|as determined|will apply|apply)\\b",
     "description": "Additional charges are open-ended or not fully listed."},

    {"id": "TE-01", "category": "termination", "level": "medium",
     "pattern": "terminat\\w*.{0,80}\\b(at any time|without (cause|reason|notice))",
     "description": "The agreement can be ended at any time or without a reason."},
    {"id": "TE-02", "category": "termination", "level": "high",
     "pattern": "terminat\\w*.{0,120}\\b(remaining|all|entire|full)\\b.{0,40}\\b(rent|payments?|balance|amount)\\b",
     "description": "Ending early may require paying the remaining amount."},
    {"id": "TE-03", "category": "termination", "level": "low",
     "pattern": "\\bnotice period\\b|\\b\\d+\\s*(days?|weeks?|months?)['’]?\\s*(prior\\s+)?(written\\s+)?notice\\b",
     "description": "A notice period is stated; check that it fits your plans."},

    {"id": "PE-01", "category": "penalties", "level": "medium",
     "pattern": "\\blate\\s+(fee|charge|payment\\s+(fee|charge|penalty))",
     "description": "A late-payment charge applies."},
    {"id": "PE-02", "category": "penalties", "level": "high",
     "pattern": "\\b\\d{1,3}(\\.\\d+)?\\s*%\\s*(per|a|each)\\s*(day|week)\\b",
     "description": "A percentage charge per day or week can grow quickly."},
    {"id": "PE-03", "category": "penalties", "level": "medium",
     "pattern": "\\b(penalt(y|ies)|liquidated damages|forfeiture)\\b",
     "description": "A penalty or fixed damages amount is mentioned."},

    {"id": "LI-01", "category": "liability", "level": "high",
     "pattern": "\\bindemnif(y|ies|ication)\\b|\\bhold\\s+harmless\\b",
     "description": "You may have to cover the other side's losses or legal costs."},
    {"id": "LI-02", "category": "liability", "level": "medium",
     "pattern": "\\b(not|no)\\s+(be\\s+)?(liable|responsible)\\b.{0,80}\\b(any|all)\\b",
     "description": "The other side limits its own responsibility broadly."},
    {"id": "LI-03", "category": "liability", "level": "medium",
     "pattern": "\\b(tenant|employee|borrower|lessee|you)\\b.{0,40}\\b(responsible|liable)\\b.{0,40}\\b(all|any)\\b",
     "description": "Broad responsibility is placed on you."},

    {"id": "UC-01", "category": "unilateral_changes", "level": "high",
     "pattern": "\\b(may|can|reserves? the right to)\\b.{0,40}\\b(change|modify|amend|alter|increase|revise)\\b.{0,80}\\b(at any time|without (prior )?(notice|consent)|sole discretion)",
     "description": "The other side can change terms without your agreement."},
    {"id": "UC-02", "category": "unilateral_changes", "level": "medium",
     "pattern": "\\bsole (and absolute )?discretion\\b",
     "description": "A decision is left to one side's sole discretion."},
    {"id": "UC-03", "category": "unilateral_changes", "level": "medium",
     "pattern": "\\b(rent|interest rate|salary|fees?|charges?)\\b.{0,40}\\b(may|can|will)\\s+be\\s+(increased|adjusted|revised|changed)\\b",
     "description": "A price or payment amount can be changed later."},

    {"id": "RR-01", "category": "rights_restrictions", "level": "high",
     "pattern": "\\b(waives?|waived|waiver of|gives? up)\\b.{0,60}\\b(rights?|claims?)\\b",
     "description": "You are asked to give up a right or claim."},
    {"id": "RR-02", "category": "rights_restrictions", "level": "medium",
     "pattern": "\\b(enter|access|inspect)\\w*\\b.{0,60}\\b(at any time|without (prior )?notice)\\b",
     "description": "The other side can enter or inspect without notice."},
    {"id": "RR-03", "category": "rights_restrictions", "level": "low",
     "pattern": "\\b(no|not)\\s+(pets?|guests?|visitors?|sublet\\w*|assign\\w*)\\b",
     "description": "A restriction limits how you can use the property or agreement."},

    {"id": "UL-01", "category": "unclear_language", "level": "low",
     "pattern": "\\b(including but not limited to|from time to time|as (deemed|determined) (necessary|appropriate)|reasonable (amount|fee|charge|costs?))\\b",
     "description": "Open-ended wording leaves room for different readings."},
    {"id": "UL-02", "category": "unclear_language", "level": "low",
     "pattern": "\\b(notwithstanding (anything|any)|except as otherwise)\\b",
     "description": "The clause may override or conflict with other clauses."},

    {"id": "NC-01", "category": "non_compete", "level": "high",
     "pattern": "\\bnon[- ]?compet\\w*|\\bshall not\\b.{0,60}\\b(compete|work for|be employed by|engage in)\\b",
     "description": "You may be limited from working elsewhere after the agreement ends."},
    {"id": "NC-02", "category": "non_compete", "level": "medium",
     "pattern": "\\bnon[- ]?solicit\\w*",
     "description": "You may be limited from contacting clients or colleagues."},

    {"id": "IR-01", "category": "interest_and_repayment", "level": "medium",
     "pattern": "\\b(variable|floating|adjustable)\\s+(interest\\s+)?rate\\b",
     "description": "The interest rate can change over time."},
    {"id": "IR-02", "category": "interest_and_repayment", "level": "medium",
     "pattern": "\\b(prepayment|early repayment|pre-closure|foreclosure)\\s+(penalty|charge|fee)s?\\b",
     "description": "Paying the loan back early costs extra."},
    {"id": "IR-03", "category": "interest_and_repayment", "level": "high",
     "pattern": "\\b(acceleration|accelerate|immediately due and payable)\\b",
     "description": "The whole balance can become due at once."},
    {"id": "IR-04", "category": "interest_and_repayment", "level": "medium",
     "pattern": "\\bcompound(ed|ing)?\\s+(daily|weekly|monthly)\\b",
     "description": "Interest compounds frequently, which raises the total cost."},

    {"id": "DR-01", "category": "dispute_resolution", "level": "medium",
     "pattern": "\\barbitrat(ion|or)\\b",
     "description": "Disputes go to arbitration instead of a regular court."},
    {"id": "DR-02", "category": "dispute_resolution", "level": "medium",
     "pattern": "\\bclass action\\b|\\bjury trial\\b",
     "description": "Your options for group claims or a jury trial may be limited."},
    {"id": "DR-03", "category": "dispute_resolution", "level": "low",
     "pattern": "\\b(governed by the laws?|exclusive jurisdiction|venue for)\\b",
     "description": "A specific place's law or courts apply to disputes."}
  ]
}
