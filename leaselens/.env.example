# LeaseLens configuration
# Copy this file to ".env" in the same folder (the project root) and edit the values.
# Never commit .env: it can contain your API key.

# --- AI provider --------------------------------------------------------------
# ollama = local Gemma 4 (default, documents stay on this computer)
# google = Gemma 4 through the Gemini API (sends document text to Google)
AI_PROVIDER=ollama

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4
# Seconds to wait for one model answer. Raise it on slower computers.
OLLAMA_TIMEOUT_SECONDS=300
# false = answer without Gemma's long "thinking" phase (faster)
OLLAMA_THINK=false

# Optional Google provider (leave the key empty to disable it)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it
GOOGLE_TIMEOUT_SECONDS=120

# --- Limits -------------------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=40
MAX_TEXT_CHARS=150000
# Clauses sent to the AI per document, and per request
MAX_CLAUSES_FOR_AI=60
AI_BATCH_SIZE=10

# --- OCR (scanned PDFs and photos) --------------------------------------------
OCR_ENABLED=true
# Full path to tesseract.exe if it is not on PATH, for example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# If Tesseract is missing, let the LOCAL Ollama model read images (only when Ollama
# reports the "vision" capability). Never uses the Google provider.
VISION_OCR_FALLBACK=true

# --- Server -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Browser origins allowed to call the API (comma-separated). "*" is refused in production.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Folder for temporary uploads (deleted after each request). Empty = system temp folder.
TEMP_DIR=
